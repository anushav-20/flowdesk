# Copy to server/.env (or set in your host's dashboard). Never commit real secrets.
NODE_ENV=development
PORT=4000
# PostgreSQL connection string, or "memory" for an in-memory demo database
DATABASE_URL=postgres://flowdesk:flowdesk@localhost:5432/flowdesk
# At least 32 random characters in production:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Protects GET /api/metrics (Bearer token)
METRICS_TOKEN=
# Optional: enables LLM-polished answers in the AI assistant
ANTHROPIC_API_KEY=
WORKER_ENABLED=true
# true = create the demo workspace (priya@acme.test / demo1234) on first start
SEED_DEMO=false
