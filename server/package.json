{
  "name": "flowdesk-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FlowDesk API: Node.js + Express + PostgreSQL + JWT, multi-tenant, with background jobs, webhooks and WebSockets.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:memory": "node --watch src/index.js --memory",
    "start:memory": "node src/index.js --memory"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
