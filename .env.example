# Copy to .env and adjust per environment.
# Only VITE_* variables reach the browser, so never put secrets here.

# REST API used by the blog, contact and newsletter features
VITE_API_BASE_URL=https://dummyjson.com

# Router: "browser" (clean URLs, needs SPA rewrites — Vercel/Netlify/Docker),
#         "hash" (GitHub Pages), "memory" (sandboxed embeds)
VITE_ROUTER_MODE=browser

# Public site URL used for canonical/SEO links
VITE_SITE_URL=https://flowdesk.example.com

# Workspace app (/app) data source:
#   empty  → demo mode: runs fully in the browser (localStorage), no server needed
#   set    → API mode: uses the Node/Express + PostgreSQL backend in /server
VITE_WORKSPACE_API_URL=
# VITE_WORKSPACE_API_URL=http://localhost:4000/api
