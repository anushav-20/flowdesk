{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "checkJs": false,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "shared"]
}
